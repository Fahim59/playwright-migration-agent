{\n  \"name\": \"playwright-migration-agent\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Production-grade AI migration system for converting Playwright JavaScript frameworks to TypeScript with reference alignment\",\n  \"main\": \"dist/index.js\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"dev\": \"ts-node src/index.ts\",\n    \"start\": \"node dist/index.js\",\n    \"migrate\": \"ts-node src/cli/migrate.ts\",\n    \"test\": \"jest\",\n    \"test:pw\": \"playwright test\",\n    \"validate\": \"node scripts/validate-setup.js\",\n    \"lint\": \"eslint src --ext .ts\",\n    \"lint:fix\": \"eslint src --ext .ts --fix\",\n    \"format\": \"prettier --write \\\"src/**/*.ts\\\"\",\n    \"type-check\": \"tsc --noEmit\",\n    \"clean\": \"rm -rf dist build out\",\n    \"docs:generate\": \"ts-node src/docs/generator.ts\"\n  },\n  \"keywords\": [\n    \"playwright\",\n    \"migration\",\n    \"typescript\",\n    \"automation\",\n    \"ast\",\n    \"langgraph\",\n    \"ai-agent\"\n  ],\n  \"author\": \"Fahim59\",\n  \"license\": \"MIT\",\n  \"dependencies\": {\n    \"@langchain/anthropic\": \"^0.1.11\",\n    \"@langchain/core\": \"^0.1.50\",\n    \"@langchain/langgraph\": \"^0.0.27\",\n    \"@playwright/test\": \"^1.54.2\",\n    \"@types/node\": \"^20.0.0\",\n    \"dotenv\": \"^16.4.7\",\n    \"ts-morph\": \"^21.0.1\",\n    \"typescript\": \"^5.3.3\",\n    \"zod\": \"^3.22.4\",\n    \"winston\": \"^3.11.0\",\n    \"chalk\": \"^5.3.0\"\n  },\n  \"devDependencies\": {\n    \"@types/jest\": \"^29.5.0\",\n    \"@typescript-eslint/eslint-plugin\": \"^6.0.0\",\n    \"@typescript-eslint/parser\": \"^6.0.0\",\n    \"eslint\": \"^8.54.0\",\n    \"prettier\": \"^3.1.0\",\n    \"ts-node\": \"^10.9.2\",\n    \"jest\": \"^29.7.0\",\n    \"ts-jest\": \"^29.1.1\"\n  },\n  \"engines\": {\n    \"node\": \">=18.0.0\",\n    \"npm\": \">=9.0.0\"\n  }\n}\n