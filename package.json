{
  "name": "playwright-migration-agent",
  "version": "1.0.0",
  "description": "Production-grade AI migration system for converting Playwright JavaScript frameworks to TypeScript with reference alignment",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "migrate": "ts-node src/cli/migrate.ts",
    "test": "playwright test",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist build out",
    "docs:generate": "ts-node src/docs/generator.ts"
  },
  "keywords": [
    "playwright",
    "migration",
    "typescript",
    "automation",
    "ast",
    "langgraph",
    "ai-agent"
  ],
  "author": "Fahim59",
  "license": "MIT",
  "dependencies": {
    "@langchain/anthropic": "^0.1.11",
    "@langchain/core": "^0.1.50",
    "@langchain/langgraph": "^0.0.27",
    "@playwright/test": "^1.54.2",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.7",
    "ts-morph": "^21.0.1",
    "typescript": "^5.3.3",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
