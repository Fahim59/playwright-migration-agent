# Environment Configuration
ENV=dev

# Claude API (for free tier, leave as is or add your key)
CLAUDE_API_KEY=

# Project paths
SOURCE_JS_PROJECT_PATH=./examples/input-projects
OUTPUT_TS_PROJECT_PATH=./examples/output-projects
REFERENCE_PROJECT_PATH=./reference-framework

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# AST Analysis
ENABLE_AST_DEBUG=false

# Agent Configuration
MAX_RETRIES=3
AGENT_TIMEOUT=300000
VALIDATION_TIMEOUT=60000

# Feature Flags
ENABLE_SELF_HEALING=true
ENABLE_AUTO_FIX=true
ENABLE_TYPE_INFERENCE=true
